# Rust
/target/
**/*.rs.bk

# Docs build output
/site-build/

# Zensical differential-build cache (root only -- the anchor keeps this from
# also swallowing a nested .cache/ elsewhere in the tree)
/.cache/
# Python / uv (docs tooling)
.venv/
__pycache__/
.pytest_cache/

# Logs
*.log

# Local runtime state
/flags.local.yaml

# Local secrets / env overrides
.env*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code local state -- everything except the checked-in skills. git never
# descends into an excluded directory, so `.claude/` itself must stay
# un-excluded and the exclusion applied to its contents instead.
/.claude/*
!/.claude/skills/
